{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "types": ["node"],
    "skipLibCheck": true
  },
  "include": ["playwright.config.ts", "tests/browser/**/*.ts", "tests/support/**/*.mjs"]
}
